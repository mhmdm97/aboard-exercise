# Optional overrides for docker compose; everything has a default, so no .env is required.
# Local-only values: do not reuse in production.
POSTGRES_PASSWORD=library
DB_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=8080
SESSION_TTL_DAYS=7
CORS_ORIGIN=http://localhost:8080
SEED_ON_START=true
# false because compose serves plain http; set true behind HTTPS.
COOKIE_SECURE=false
