{
  "name": "library",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["shared", "backend", "frontend", "e2e"],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @library/backend\" \"npm run dev -w abroad-frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @library/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
